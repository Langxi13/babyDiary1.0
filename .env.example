# MySQL
DB_URL='jdbc:mysql://127.0.0.1:3306/baby_diary?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&useSSL=false&allowPublicKeyRetrieval=true'
DB_USERNAME=baby_diary
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# Application and authentication
DIARY_OBJECT_PATH=./data/objects/
INVITATION_CODE=replace-with-a-private-invitation-code
INVITATION_CODE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRATION=900000
AUTH_REFRESH_DAYS=30
AUTH_SECURE_COOKIE=false
AUTH_STEP_UP_MINUTES=10
PUBLIC_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Android release discovery. DIRECT requires an HTTPS or same-origin APK URL and SHA-256.
ANDROID_UPDATE_ENABLED=false
ANDROID_UPDATE_DISTRIBUTION=DIRECT
ANDROID_UPDATE_VERSION_CODE=0
ANDROID_UPDATE_VERSION_NAME=
ANDROID_MINIMUM_VERSION_CODE=1
ANDROID_UPDATE_URL=
ANDROID_UPDATE_SHA256=
ANDROID_UPDATE_RELEASE_NOTES=
ANDROID_UPDATE_MANDATORY=false

# Redis cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
CACHE_ENABLED=true
CACHE_PREFIX=baby-diary:cache:
OUTBOX_ENABLED=true
OUTBOX_POLL_DELAY_MS=2000
REMINDERS_ENABLED=true
REMINDER_DELIVERY_DELAY_MS=60000
AI_SCHEDULES_ENABLED=true
AI_SCHEDULE_POLL_DELAY_MS=60000
RETENTION_ENABLED=true
DIARY_TRASH_DAYS=30
SYNC_RETENTION_DAYS=90

# AI provider configuration encryption
AI_CONFIG_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Optional email delivery. Spring Boot reads the SPRING_MAIL_* variables directly.
MAIL_ENABLED=false
MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Optional Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Rich media storage: local or s3
OBJECT_STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=baby-diary
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional media processing tools
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIPSTHUMBNAIL_PATH=vipsthumbnail
VIPSHEADER_PATH=vipsheader
CWEBP_PATH=cwebp
MEDIA_DERIVATIVE_BACKFILL_ENABLED=true
MEDIA_DERIVATIVE_BACKFILL_BATCH_SIZE=12
MEDIA_DERIVATIVE_BACKFILL_INITIAL_DELAY_MS=60000
MEDIA_DERIVATIVE_BACKFILL_DELAY_MS=300000
PDF_FONT_PATH=/usr/share/fonts/truetype/unifont/unifont.ttf

# Runtime tuning
SLOW_REQUEST_THRESHOLD_MS=1000
SPRINGDOC_ENABLED=true
