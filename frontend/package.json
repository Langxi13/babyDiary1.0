{
  "name": "baby-diary-frontend",
  "version": "1.0.0-beta.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "native:sync": "npm run build && cap sync",
    "native:android:sync": "npm run build && cap sync android",
    "native:android:build": "bash ../scripts/build-android.sh",
    "native:ios:sync": "npm run build && cap sync ios",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/file-transfer": "2.0.6",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@tiptap/vue-3": "^3.32.1",
    "axios": "^1.21.0",
    "element-plus": "^2.14.7",
    "pinia": "^2.3.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.25",
    "sass": "^1.107.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "glob": "13.0.6",
    "tar": "7.5.22"
  }
}
